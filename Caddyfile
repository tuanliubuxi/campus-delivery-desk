# Bare-IP clients may omit TLS SNI, so select the configured host's certificate as a fallback.
{
	default_sni {$TLS_DEFAULT_SNI:localhost}
}

# Terminate HTTP(S), compress responses, and proxy application traffic to Django.
{$APP_DOMAIN:localhost} {
	encode zstd gzip

	# Static assets are public; media files deliberately remain behind Django permission checks.
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		# Preserve a single application origin for HTML, API-like endpoints and the PWA.
		reverse_proxy web:8000 {
			# Production is always public HTTPS, including when an upstream gateway
			# terminates TLS before forwarding to Caddy's local HTTP listener.
			header_up X-Forwarded-Proto {$PUBLIC_SCHEME:https}
		}
	}
}
