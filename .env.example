# Copy to .env and replace every example value before production use.
# Django security and public-origin settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:18443

# Public application identity and deployment timezone.
SYSTEM_TIMEZONE=Asia/Shanghai
APP_BASE_URL=https://localhost:18443
APP_DOMAIN=localhost
# Set this to the same LAN IP/hostname as APP_DOMAIN for direct HTTPS access from other devices.
TLS_DEFAULT_SNI=localhost
# Public browser scheme forwarded by Caddy. Keep https when TLS ends at Caddy or an upstream gateway.
PUBLIC_SCHEME=https
# Host ports exposed by Caddy. Non-privileged defaults avoid common Windows port reservations.
# A fixed-domain public deployment may change these to 80/443 after confirming both ports are free.
HTTP_PORT=18080
HTTPS_PORT=18443

# Persistent/runtime paths are container paths backed by the host ./data mount.
DATA_ROOT=/data
DB_PATH=/data/db/app.sqlite3
MEDIA_ROOT=/data/media
BACKUP_ROOT=/data/backups
TMP_ROOT=/data/tmp
LOG_ROOT=/data/logs

# Keep secure cookies enabled whenever Caddy serves the production site over HTTPS.
SESSION_COOKIE_SECURE=true
