# Copy to .env and replace every example value before production use.
# Django security and public-origin settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=delivery.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://delivery.example.com

# Public application identity and deployment timezone.
SYSTEM_TIMEZONE=Asia/Shanghai
APP_BASE_URL=https://delivery.example.com
APP_DOMAIN=delivery.example.com

# Persistent/runtime paths are container paths backed by the host ./data mount.
DATA_ROOT=/data
DB_PATH=/data/db/app.sqlite3
MEDIA_ROOT=/data/media
BACKUP_ROOT=/data/backups
TMP_ROOT=/data/tmp
LOG_ROOT=/data/logs

# Keep secure cookies enabled whenever Caddy serves the production site over HTTPS.
SESSION_COOKIE_SECURE=true
